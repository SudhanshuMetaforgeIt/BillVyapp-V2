# BillVyApp V2 - Main Server (NestJS)
# Copy to .env and fill in real values. .env is git-ignored.
# This file must never contain real secrets.
#
# NOTE: Prisma 7 does not auto-load .env. prisma.config.ts loads this file
# so `npx prisma generate` / `npx prisma migrate` work from the project root.
# The Nest application itself loads .env via @nestjs/config.

# --- Runtime ------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public base URL used to build local media upload/download links.
APP_URL="http://localhost:3000"

# Comma-free single origin (e.g. http://localhost:3001). Use * in local
# development — the server reflects the request Origin so credentialed
# HttpOnly refresh cookies still work.
CORS_ORIGIN="http://localhost:3001"

# --- Database (local MySQL 8 — do not use a MySQL container for this setup) --
# Application connections force session time_zone='+00:00' / connector timezone:'Z'.
# Do not rely on the host OS timezone. Historical DATETIME rows are not rewritten.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/billvyapp_v2"

# --- JWT ----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters; the app refuses to boot otherwise.
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- OTP ----------------------------------------------------------------
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# Development-only: include `devOtp` in POST /api/auth/send-otp.
# Ignored when NODE_ENV=production — the code is never returned in production.
DEV_OTP_ENABLED=true

# --- Local seed accounts (npm run db:seed) --------------------------------
# Super Admin  login.test@billvyapp.local     /  Billvy@Dev123
# Admin        admin.test@billvyapp.local     /  Billvy@Dev123
# Manager      manager.test@billvyapp.local   /  Billvy@Dev123

# --- Redis (OTP store + BullMQ notification queue) ----------------------
# Use the existing Redis Docker container already running on this PC.
# Do not install a second Redis. Example container name: redis-stack
REDIS_URL="redis://localhost:6379"

# --- Media storage ------------------------------------------------------
# local  = filesystem under STORAGE_LOCAL_ROOT (recommended for PC/dev)
# s3     = AWS S3 / S3-compatible (Ubuntu/production later)
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT="./storage"
# Full database backups require MySQL client tools on PATH.
# Set these to absolute executable paths when MySQL is installed elsewhere.
# MYSQLDUMP_PATH="C:/Program Files/MySQL/MySQL Server 8.4/bin/mysqldump.exe"
# MYSQL_CLIENT_PATH="C:/Program Files/MySQL/MySQL Server 8.4/bin/mysql.exe"
# Optional override; defaults to JWT_ACCESS_SECRET for signing local URLs.
# STORAGE_SIGNING_SECRET=""
STORAGE_PRESIGN_EXPIRES_SECONDS=900

# --- Object storage (optional — only when STORAGE_PROVIDER=s3) ----------
# Leave empty for local development. Required only for production S3.
S3_REGION="ap-south-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional for MinIO / compatible endpoints:
# S3_ENDPOINT="http://localhost:9000"
# S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_SECONDS=900

# --- Public salon images (Cloudinary temporary provider) -----------------
# This storage path is deliberately separate from private media such as bills.
# The client receives optimized delivery URLs only; never expose the API secret.
SALON_IMAGE_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_EXPIRES_SECONDS=900

# User avatars default to STORAGE_PROVIDER; override to use temporary Cloudinary.
# Private documents continue to use STORAGE_PROVIDER.
# PROFILE_PHOTO_STORAGE_PROVIDER=cloudinary

# --- Salon geocoding (backend only) ------------------------------------
GEOCODING_PROVIDER=google
GOOGLE_API_KEY=""
PERFORMANCE_BASELINE=false
# GOOGLE_MAPS_API_KEY is also supported.
# Optional alternative: GEOCODING_PROVIDER=opencage and OPENCAGE_API_KEY=""
